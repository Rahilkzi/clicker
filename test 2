# HEADER
# ============================================================

print()
print("=" * 55)
print("              SAP UI AUTOMATION TEST")
print("=" * 55)
print()


# ============================================================
# FIND SAP PRINT WINDOWS
# ============================================================

print("=" * 15, "SAP PRINT WINDOWS", "=" * 15)
print()

print_windows = []

try:
    all_windows = desktop.windows(visible_only=True)
except Exception:
    all_windows = []


for window in all_windows:

    try:
        title = safe_text(window)
        class_name = window.class_name()

        if title == "Print:":

            pid = window.element_info.process_id

            print_windows.append(window)

            print("WINDOW")
            print("Title  :", repr(title))
            print("Class  :", repr(class_name))
            print("Handle :", window.handle)
            print("PID    :", pid)

            print()
            print("--- BUTTONS ---")

            try:
                buttons = window.descendants(class_name="Button")

                for i, button in enumerate(buttons):

                    try:
                        print(
                            f"[{i}] "
                            f"text={button.window_text()!r} "
                            f"class={button.class_name()!r} "
                            f"handle={button.handle}"
                        )
                    except Exception:
                        pass

            except Exception as e:
                print("Could not read buttons:", e)

            print()
            print("-" * 55)
            print()

    except Exception:
        pass


# ============================================================
# PRINT WINDOW RESULT
# ============================================================

if print_windows:

    print(
        f"✓ SAP Print window found: "
        f"{len(print_windows)}"
    )

else:

    print("❌ SAP Print window NOT FOUND")


# ============================================================
# FIND WINDOWS ERROR DIALOGS
# ============================================================

print()
print("=" * 15, "SAP ERROR WINDOWS", "=" * 15)
print()


error_windows = []


for window in all_windows:

    try:

        # Windows standard dialog class
        if window.class_name() != "#32770":
            continue

        title = safe_text(window)

        # Only inspect dialogs that belong to SAP
        pid = window.element_info.process_id

        # If we have a Print window, prioritize dialogs
        # belonging to the same SAP process.
        same_sap_process = False

        for print_window in print_windows:

            try:

                print_pid = print_window.element_info.process_id

                if pid == print_pid:
                    same_sap_process = True
                    break

            except Exception:
                pass

        if not same_sap_process:
            continue

        # Check actual dialog contents
        if control_contains_error(window):

            error_windows.append(window)

            print("✓ TARGET PDF ERROR WINDOW FOUND")
            print()
            print("Title  :", repr(title))
            print("Class  :", repr(window.class_name()))
            print("Handle :", window.handle)
            print("PID    :", pid)

            print()
            print("--- CONTROLS ---")

            try:

                for i, control in enumerate(window.descendants()):

                    text = safe_text(control)

                    if text:

                        try:
                            print(
                                f"[{i}] "
                                f"text={text!r} "
                                f"class={control.class_name()!r} "
                                f"handle={control.handle}"
                            )
                        except Exception:
                            pass

            except Exception:
                pass

            print()
            print("-" * 55)
            print()

    except Exception:
        pass


