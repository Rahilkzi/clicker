import time
import logging
import threading

import keyboard
from winotify import Notification, audio
from pywinauto import Desktop

# Windows session monitoring
import win32api
import win32gui
import win32ts


# ============================================================
# SAP AUTO PRINT AUTOMATION
# ============================================================

desktop = Desktop(backend="win32")


# ============================================================
# SETTINGS
# ============================================================

CHECK_INTERVAL = 0.2
ERROR_CHECK_INTERVAL = 0.2

# Maximum time to wait after clicking Print
PRINT_WAIT_TIMEOUT = 15

# Small delay after Print/Error handling
ACTION_DELAY = 0.5


# ============================================================
# LOGGING
# ============================================================

logging.basicConfig(
    filename="sap_auto_print.log",
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s"
)


def log(message):

    try:
        logging.info(message)
    except Exception:
        pass


# ============================================================
# AUTOMATION STATE
# ============================================================

automation_running = False
shutdown_requested = False

state_lock = threading.Lock()
hotkey_lock = threading.Lock()

f8_hotkey = None


# ============================================================
# WINDOWS TOAST NOTIFICATION
# ============================================================

def show_notification(title, message):

    try:

        toast = Notification(
            app_id="SAP Auto Print",
            title=title,
            msg=message
        )

        toast.set_audio(
            audio.Default,
            loop=False
        )

        toast.show()

        log(
            f"Notification sent: {title} | {message}"
        )

    except Exception as e:

        log(
            "Notification error: "
            + repr(e)
        )


# ============================================================
# F8 START / STOP
# ============================================================

def toggle_automation():

    global automation_running

    log(
        "F8 PRESSED"
    )

    with state_lock:

        automation_running = not automation_running

        running = automation_running


    log(
        f"F8 TOGGLE RESULT: "
        f"automation_running={running}"
    )


    if running:

        log(
            "Automation STARTED"
        )

        show_notification(
            "SAP Auto Print",
            "Automation STARTED"
        )

    else:

        log(
            "Automation STOPPED"
        )

        show_notification(
            "SAP Auto Print",
            "Automation STOPPED"
        )


# ============================================================
# REGISTER / RE-REGISTER F8
# ============================================================

def register_f8():

    global f8_hotkey

    with hotkey_lock:

        try:

            # ------------------------------------------------
            # Remove previous F8 hook if it exists
            # ------------------------------------------------

            if f8_hotkey is not None:

                try:

                    keyboard.remove_hotkey(
                        f8_hotkey
                    )

                    log(
                        "Previous F8 hotkey removed."
                    )

                except Exception as e:

                    log(
                        "Could not remove previous F8 hotkey: "
                        + repr(e)
                    )

                f8_hotkey = None


            # ------------------------------------------------
            # Register F8
            # ------------------------------------------------

            f8_hotkey = keyboard.add_hotkey(
                "f8",
                toggle_automation
            )


            log(
                "F8 hotkey registered successfully."
            )

            return True


        except Exception as e:

            log(
                "F8 hotkey registration error: "
                + repr(e)
            )

            f8_hotkey = None

            return False


# ============================================================
# WINDOWS SESSION CONSTANTS
# ============================================================

WM_WTSSESSION_CHANGE = 0x02B1

WTS_SESSION_LOCK = 0x7
WTS_SESSION_UNLOCK = 0x8

NOTIFY_FOR_THIS_SESSION = 0


# ============================================================
# WINDOWS SESSION CALLBACK
# ============================================================

def session_window_proc(
    hwnd,
    msg,
    wparam,
    lparam
):

    try:

        # ====================================================
        # SESSION CHANGE
        # ====================================================

        if msg == WM_WTSSESSION_CHANGE:

            # ------------------------------------------------
            # WINDOWS LOCKED
            # ------------------------------------------------

            if wparam == WTS_SESSION_LOCK:

                log(
                    "WINDOWS SESSION LOCKED"
                )


            # ------------------------------------------------
            # WINDOWS UNLOCKED
            # ------------------------------------------------

            elif wparam == WTS_SESSION_UNLOCK:

                log(
                    "WINDOWS SESSION UNLOCKED"
                )


                # ------------------------------------------------
                # Give Windows time to restore the interactive
                # desktop after unlocking.
                # ------------------------------------------------

                time.sleep(
                    1.5
                )


                log(
                    "Re-registering F8 after Windows unlock..."
                )


                success = register_f8()


                if success:

                    log(
                        "F8 successfully restored after unlock."
                    )


                    show_notification(
                        "SAP Auto Print",
                        "Windows unlocked - F8 restored"
                    )

                else:

                    log(
                        "FAILED to restore F8 after unlock."
                    )


        # ----------------------------------------------------
        # Pass unhandled messages to Windows
        # ----------------------------------------------------

        return win32gui.DefWindowProc(
            hwnd,
            msg,
            wparam,
            lparam
        )


    except Exception as e:

        log(
            "Session callback error: "
            + repr(e)
        )

        return 0


# ============================================================
# WINDOWS SESSION MONITOR
# ============================================================

def session_monitor():

    log(
        "Starting Windows session monitor..."
    )


    try:

        # ====================================================
        # GET CURRENT PROCESS MODULE
        # ====================================================

        h_instance = win32api.GetModuleHandle(
            None
        )


        # ====================================================
        # UNIQUE WINDOW CLASS NAME
        # ====================================================

        process_id = (
            win32api.GetCurrentProcessId()
        )


        class_name = (
            "SAPAutoPrintSessionMonitor_"
            + str(process_id)
        )


        # ====================================================
        # CREATE WINDOW CLASS
        # ====================================================

        wnd_class = win32gui.WNDCLASS()

        wnd_class.hInstance = h_instance

        wnd_class.lpszClassName = class_name

        wnd_class.lpfnWndProc = (
            session_window_proc
        )


        # ====================================================
        # REGISTER WINDOW CLASS
        # ====================================================

        try:

            win32gui.RegisterClass(
                wnd_class
            )

            log(
                "Session monitor window class registered."
            )

        except Exception as e:

            # ------------------------------------------------
            # Usually means class already exists.
            # ------------------------------------------------

            log(
                "Window class registration message: "
                + repr(e)
            )


        # ====================================================
        # CREATE HIDDEN WINDOW
        # ====================================================

        hwnd = win32gui.CreateWindow(
            class_name,
            "SAP Auto Print Session Monitor",
            0,
            0,
            0,
            0,
            0,
            0,
            0,
            h_instance,
            None
        )


        if not hwnd:

            log(
                "Could not create session monitor window."
            )

            return


        log(
            f"Session monitor window created. HWND={hwnd}"
        )


        # ====================================================
        # REGISTER WINDOWS SESSION NOTIFICATION
        # ====================================================

        result = (
            win32ts.WTSRegisterSessionNotification(
                hwnd,
                NOTIFY_FOR_THIS_SESSION
            )
        )


        if not result:

            log(
                "WTSRegisterSessionNotification failed."
            )


            try:

                win32gui.DestroyWindow(
                    hwnd
                )

            except Exception:
                pass


            return


        log(
            "Windows session monitor started successfully."
        )


        # ====================================================
        # WINDOWS MESSAGE LOOP
        # ====================================================

        while not shutdown_requested:

            win32gui.PumpWaitingMessages()

            time.sleep(
                0.1
            )


        # ====================================================
        # CLEANUP
        # ====================================================

        try:

            win32ts.WTSUnRegisterSessionNotification(
                hwnd
            )

        except Exception as e:

            log(
                "Session notification cleanup error: "
                + repr(e)
            )


        try:

            win32gui.DestroyWindow(
                hwnd
            )

        except Exception:
            pass


        log(
            "Windows session monitor stopped."
        )


    except Exception as e:

        log(
            "Session monitor error: "
            + repr(e)
        )


# ============================================================
# FIND SAP PRINT WINDOWS
# ============================================================

def get_print_windows():

    result = []

    try:

        windows = desktop.windows(
            title="Print:",
            class_name="#32770",
            visible_only=True
        )


        for window in windows:

            try:

                if window.is_visible():

                    result.append(
                        window
                    )

            except Exception:
                pass


    except Exception as e:

        log(
            "Print window enumeration error: "
            + repr(e)
        )


    return result


# ============================================================
# FIND PDF ERROR WINDOWS
# ============================================================

def get_pdf_error_windows():

    result = []

    try:

        dialogs = desktop.windows(
            class_name="#32770",
            visible_only=True
        )

    except Exception as e:

        log(
            "PDF dialog enumeration error: "
            + repr(e)
        )

        return result


    for dialog in dialogs:

        try:

            if not dialog.is_visible():

                continue


            title = (
                dialog
                .window_text()
                .strip()
            )


            # ------------------------------------------------
            # PDF ERROR IDENTIFICATION
            #
            # Example:
            #
            # C:\temp\0999324283.pdf
            # ------------------------------------------------

            if not title.lower().endswith(".pdf"):

                continue


            # ------------------------------------------------
            # FIND OK BUTTON
            # ------------------------------------------------

            ok_button = None


            try:

                buttons = dialog.descendants(
                    class_name="Button"
                )


                for button in buttons:

                    try:

                        text = (
                            button
                            .window_text()
                            .strip()
                            .upper()
                        )


                        if text == "OK":

                            ok_button = button

                            break


                    except Exception:
                        pass


            except Exception:
                pass


            # ------------------------------------------------
            # ACCEPT ONLY IF OK EXISTS
            # ------------------------------------------------

            if ok_button is not None:

                result.append(
                    (
                        dialog,
                        ok_button
                    )
                )


        except Exception:
            pass


    return result


# ============================================================
# FIND SAP PRINT BUTTON
# ============================================================

def find_print_button(print_window):

    try:

        buttons = print_window.descendants(
            class_name="Button"
        )


        log(
            f"Buttons found in Print window: "
            f"{len(buttons)}"
        )


        # ----------------------------------------------------
        # YOUR TESTED SAP PRINT DIALOG
        #
        # [2] = PRINT button
        # ----------------------------------------------------

        if len(buttons) >= 3:

            candidate = buttons[2]


            try:

                if candidate.is_visible():

                    return candidate


            except Exception:
                pass


        return None


    except Exception as e:

        log(
            "Print button detection error: "
            + repr(e)
        )

        return None


# ============================================================
# CLICK PRINT BUTTON
# ============================================================

def click_print(print_window):

    try:

        log(
            "Finding PRINT button..."
        )


        print_button = find_print_button(
            print_window
        )


        if print_button is None:

            log(
                "PRINT button could not be identified."
            )

            return False


        # ----------------------------------------------------
        # LOG BUTTON INFORMATION
        # ----------------------------------------------------

        try:

            log(
                f"Print button handle: "
                f"{print_button.handle}"
            )


            log(
                f"Print button class: "
                f"{print_button.class_name()}"
            )


            log(
                f"Print button text: "
                f"{print_button.window_text()!r}"
            )


            log(
                f"Print button position: "
                f"{print_button.rectangle()}"
            )


        except Exception:
            pass


        # ----------------------------------------------------
        # CLICK PRINT
        # ----------------------------------------------------

        log(
            "Clicking PRINT button..."
        )


        print_button.click()


        log(
            "PRINT button clicked successfully."
        )


        return True


    except Exception as e:

        log(
            "Could not click PRINT button: "
            + repr(e)
        )

        return False


# ============================================================
# CLOSE PDF ERROR
# ============================================================

def close_pdf_error(
    dialog,
    ok_button
):

    try:

        title = dialog.window_text()


        log(
            "PDF ERROR DETECTED: "
            + repr(title)
        )


        log(
            f"PDF dialog handle: "
            f"{dialog.handle}"
        )


        log(
            f"OK button handle: "
            f"{ok_button.handle}"
        )


        log(
            "Clicking OK..."
        )


        ok_button.click()


        log(
            "PDF error closed successfully."
        )


        return True


    except Exception as e:

        log(
            "Could not close PDF error: "
            + repr(e)
        )

        return False


# ============================================================
# WAIT FOR PRINT RESULT
# ============================================================

def wait_after_print(print_window):

    start_time = time.time()


    log(
        "Waiting for print result..."
    )


    while (
        time.time() - start_time
        < PRINT_WAIT_TIMEOUT
    ):

        # ====================================================
        # CHECK PDF ERROR FIRST
        # ====================================================

        errors = get_pdf_error_windows()


        if errors:

            log(
                "PDF error window detected."
            )


            for dialog, ok_button in errors:

                close_pdf_error(
                    dialog,
                    ok_button
                )


            time.sleep(
                ACTION_DELAY
            )


            return "ERROR"


        # ====================================================
        # CHECK WHETHER PRINT WINDOW CLOSED
        # ====================================================

        try:

            if not print_window.exists():

                log(
                    "Print window closed."
                )

                return "SUCCESS"


        except Exception:

            # Window handle is no longer valid.
            return "SUCCESS"


        # ====================================================
        # WAIT A LITTLE
        # ====================================================

        time.sleep(
            ERROR_CHECK_INTERVAL
        )


    # ========================================================
    # TIMEOUT
    # ========================================================

    log(
        "Print operation timed out."
    )


    return "TIMEOUT"


# ============================================================
# STARTUP
# ============================================================

log(
    "=" * 60
)

log(
    "SAP Auto Print started."
)


# ============================================================
# REGISTER F8
# ============================================================

if register_f8():

    log(
        "Initial F8 registration completed."
    )

else:

    log(
        "Initial F8 registration FAILED."
    )


# ============================================================
# START WINDOWS SESSION MONITOR
# ============================================================

session_thread = threading.Thread(
    target=session_monitor,
    daemon=True
)

session_thread.start()


# ============================================================
# STARTUP NOTIFICATION
# ============================================================

show_notification(
    "SAP Auto Print",
    "Ready — press F8 to START"
)


# ============================================================
# MAIN AUTOMATION LOOP
# ============================================================

while not shutdown_requested:

    try:

        # ====================================================
        # WAIT WHILE AUTOMATION IS STOPPED
        # ====================================================

        if not automation_running:

            time.sleep(
                CHECK_INTERVAL
            )

            continue


        # ====================================================
        # 1. PDF ERROR HAS HIGHEST PRIORITY
        # ====================================================

        errors = get_pdf_error_windows()


        if errors:

            for dialog, ok_button in errors:

                close_pdf_error(
                    dialog,
                    ok_button
                )


            time.sleep(
                ACTION_DELAY
            )

            continue


        # ====================================================
        # 2. FIND SAP PRINT WINDOWS
        # ====================================================

        print_windows = get_print_windows()


        if not print_windows:

            time.sleep(
                CHECK_INTERVAL
            )

            continue


        # ====================================================
        # 3. PROCESS PRINT WINDOW
        # ====================================================

        for print_window in print_windows:

            try:

                # --------------------------------------------
                # Check F8 state before processing
                # --------------------------------------------

                if not automation_running:

                    break


                handle = print_window.handle


                log(
                    "=" * 60
                )


                log(
                    "PRINT WINDOW DETECTED"
                )


                log(
                    f"Handle: {handle}"
                )


                try:

                    log(
                        "PID: "
                        + str(
                            print_window
                            .element_info
                            .process_id
                        )
                    )

                except Exception:
                    pass


                log(
                    "Title: "
                    + repr(
                        print_window.window_text()
                    )
                )


                # =================================================
                # CLICK PRINT
                # =================================================

                clicked = click_print(
                    print_window
                )


                if not clicked:

                    log(
                        "PRINT button was not clicked."
                    )


                    # Don't remember this window.
                    # It can be tried again.

                    time.sleep(
                        0.5
                    )

                    continue


                # =================================================
                # WAIT FOR THIS PRINT OPERATION
                # =================================================

                result = wait_after_print(
                    print_window
                )


                # =================================================
                # RESULT
                # =================================================

                if result == "SUCCESS":

                    log(
                        "PRINT COMPLETED."
                    )


                elif result == "ERROR":

                    log(
                        "PDF ERROR HANDLED."
                    )


                elif result == "TIMEOUT":

                    log(
                        "PRINT RESULT TIMEOUT."
                    )


                # =================================================
                # READY FOR NEXT PRINT
                # =================================================

                log(
                    "Ready for next SAP print..."
                )


                time.sleep(
                    ACTION_DELAY
                )


                # ------------------------------------------------
                # Process one Print dialog per polling cycle.
                # ------------------------------------------------

                break


            except Exception as e:

                log(
                    "Print window processing error: "
                    + repr(e)
                )


                time.sleep(
                    0.5
                )


                continue


        # ====================================================
        # SMALL POLLING DELAY
        # ====================================================

        time.sleep(
            CHECK_INTERVAL
        )


    # ========================================================
    # UNEXPECTED ERROR
    # ========================================================

    except Exception as e:

        log(
            "Main automation error: "
            + repr(e)
        )


        time.sleep(
            1
        )


# ============================================================
# SHUTDOWN
# ============================================================

try:

    keyboard.unhook_all()

except Exception:
    pass


log(
    "SAP Auto Print stopped."
)


show_notification(
    "SAP Auto Print",
    "Automation CLOSED"
)