from pywinauto import Desktop
import time


# ============================================================
# SAP UI AUTOMATION TEST
# ============================================================

desktop = Desktop(backend="win32")

TARGET_ERROR_TEXT = (
    "This file does not have an app associated with it"
)

SAP_PROCESS_NAME = "saplogon.exe"


def safe_text(control):
    """Safely get text from a window/control."""
    try:
        return control.window_text().strip()
    except Exception:
        return ""


def get_process_name(window):
    """Safely get process name."""
    try:
        return window.element_info.process_id
    except Exception:
        return None


def control_contains_error(window):
    """
    Check all controls inside a dialog for the
    Windows PDF association error.
    """

    # Check window title itself
    title = safe_text(window)

    if TARGET_ERROR_TEXT.lower() in title.lower():
        return True

    # Check every child control
    try:
        controls = window.descendants()
    except Exception:
        return False

    for control in controls:

        text = safe_text(control)

        if not text:
            continue

        if TARGET_ERROR_TEXT.lower() in text.lower():
            return True

    return False


