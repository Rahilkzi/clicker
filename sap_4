import os
import time
import logging
import threading

import keyboard
from winotify import Notification, audio
from pywinauto import Desktop


# ============================================================
# SAP AUTO PRINT AUTOMATION
# ============================================================

desktop = Desktop(backend="win32")


# ============================================================
# SETTINGS
# ============================================================

CHECK_INTERVAL = 0.2
ERROR_CHECK_INTERVAL = 0.2

# Maximum time to wait after clicking Print
PRINT_WAIT_TIMEOUT = 15

# Small delay after Print/Error handling
ACTION_DELAY = 0.5


# ============================================================
# LOGGING
# ============================================================

# Always create the log beside this script.
# This is important when running through Task Scheduler.

SCRIPT_DIR = os.path.dirname(
    os.path.abspath(__file__)
)

LOG_FILE = os.path.join(
    SCRIPT_DIR,
    "sap_auto_print.log"
)


logging.basicConfig(
    filename=LOG_FILE,
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    encoding="utf-8"
)


def log(message):

    try:
        logging.info(message)
    except Exception:
        pass


# ============================================================
# AUTOMATION STATE
# ============================================================

automation_running = False
shutdown_requested = False

state_lock = threading.Lock()


# ============================================================
# WINDOWS TOAST NOTIFICATION
# ============================================================

def show_notification(title, message):

    try:

        toast = Notification(
            app_id="SAP Auto Print",
            title=title,
            msg=message
        )

        toast.set_audio(
            audio.Default,
            loop=False
        )

        toast.show()

        log(
            f"Notification sent: "
            f"{title} | {message}"
        )

    except Exception as e:

        log(
            "Notification error: "
            + repr(e)
        )


# ============================================================
# F8 START / STOP
# ============================================================

def toggle_automation():

    global automation_running

    log(
        "F8 PRESSED"
    )

    with state_lock:

        automation_running = not automation_running

        running = automation_running

    if running:

        log(
            "Automation STARTED"
        )

        show_notification(
            "SAP Auto Print",
            "Automation STARTED"
        )

    else:

        log(
            "Automation STOPPED"
        )

        show_notification(
            "SAP Auto Print",
            "Automation STOPPED"
        )


# ============================================================
# REGISTER F8
# ============================================================

try:

    keyboard.add_hotkey(
        "f8",
        toggle_automation
    )

    log(
        "F8 hotkey registered successfully."
    )

except Exception as e:

    log(
        "F8 registration error: "
        + repr(e)
    )


# ============================================================
# FIND SAP PRINT WINDOWS
# ============================================================

def get_print_windows():

    result = []

    try:

        windows = desktop.windows(
            title="Print:",
            class_name="#32770",
            visible_only=True
        )

        for window in windows:

            try:

                if window.is_visible():

                    result.append(
                        window
                    )

            except Exception:
                pass

    except Exception as e:

        log(
            "Print window enumeration error: "
            + repr(e)
        )

    return result


# ============================================================
# FIND PDF ERROR WINDOWS
# ============================================================

def get_pdf_error_windows():

    result = []

    try:

        dialogs = desktop.windows(
            class_name="#32770",
            visible_only=True
        )

    except Exception as e:

        log(
            "PDF dialog enumeration error: "
            + repr(e)
        )

        return result

    for dialog in dialogs:

        try:

            if not dialog.is_visible():

                continue

            title = (
                dialog
                .window_text()
                .strip()
            )

            # ------------------------------------------------
            # PDF ERROR IDENTIFICATION
            #
            # Example:
            #
            # C:\temp\0999324283.pdf
            # ------------------------------------------------

            if not title.lower().endswith(".pdf"):

                continue

            # ------------------------------------------------
            # FIND OK BUTTON
            # ------------------------------------------------

            ok_button = None

            try:

                buttons = dialog.descendants(
                    class_name="Button"
                )

                for button in buttons:

                    try:

                        text = (
                            button
                            .window_text()
                            .strip()
                            .upper()
                        )

                        if text == "OK":

                            ok_button = button

                            break

                    except Exception:
                        pass

            except Exception:
                pass

            # ------------------------------------------------
            # ACCEPT ONLY IF OK EXISTS
            # ------------------------------------------------

            if ok_button is not None:

                result.append(
                    (
                        dialog,
                        ok_button
                    )
                )

        except Exception:
            pass

    return result


# ============================================================
# FIND SAP PRINT BUTTON
# ============================================================

def find_print_button(print_window):

    try:

        buttons = print_window.descendants(
            class_name="Button"
        )

        log(
            "Buttons found in Print window: "
            + str(len(buttons))
        )

        # ----------------------------------------------------
        # YOUR TESTED SAP PRINT DIALOG
        #
        # [2] = PRINT button
        # ----------------------------------------------------

        if len(buttons) >= 3:

            candidate = buttons[2]

            try:

                if candidate.is_visible():

                    return candidate

            except Exception:
                pass

        return None

    except Exception as e:

        log(
            "Print button detection error: "
            + repr(e)
        )

        return None


# ============================================================
# CLICK PRINT BUTTON
# ============================================================

def click_print(print_window):

    try:

        log(
            "Finding PRINT button..."
        )

        print_button = find_print_button(
            print_window
        )

        if print_button is None:

            log(
                "PRINT button could not be identified."
            )

            return False

        # ----------------------------------------------------
        # LOG BUTTON INFORMATION
        # ----------------------------------------------------

        try:

            log(
                f"Print button handle: "
                f"{print_button.handle}"
            )

            log(
                f"Print button class: "
                f"{print_button.class_name()}"
            )

            log(
                f"Print button text: "
                f"{print_button.window_text()!r}"
            )

            log(
                f"Print button position: "
                f"{print_button.rectangle()}"
            )

        except Exception:
            pass

        # ----------------------------------------------------
        # CLICK PRINT
        # ----------------------------------------------------

        log(
            "Clicking PRINT button..."
        )

        print_button.click()

        log(
            "PRINT button clicked successfully."
        )

        return True

    except Exception as e:

        log(
            "Could not click PRINT button: "
            + repr(e)
        )

        return False


# ============================================================
# CLOSE PDF ERROR
# ============================================================

def close_pdf_error(dialog, ok_button):

    try:

        title = dialog.window_text()

        log(
            "PDF ERROR DETECTED: "
            + repr(title)
        )

        log(
            f"PDF dialog handle: "
            f"{dialog.handle}"
        )

        log(
            f"OK button handle: "
            f"{ok_button.handle}"
        )

        log(
            "Clicking OK..."
        )

        ok_button.click()

        log(
            "PDF error closed successfully."
        )

        return True

    except Exception as e:

        log(
            "Could not close PDF error: "
            + repr(e)
        )

        return False


# ============================================================
# WAIT FOR PRINT RESULT
# ============================================================

def wait_after_print(print_window):

    start_time = time.time()

    log(
        "Waiting for print result..."
    )

    while (
        time.time() - start_time
        < PRINT_WAIT_TIMEOUT
    ):

        # ====================================================
        # CHECK PDF ERROR FIRST
        # ====================================================

        errors = get_pdf_error_windows()

        if errors:

            log(
                "PDF error window detected."
            )

            for dialog, ok_button in errors:

                close_pdf_error(
                    dialog,
                    ok_button
                )

            time.sleep(
                ACTION_DELAY
            )

            return "ERROR"

        # ====================================================
        # CHECK WHETHER PRINT WINDOW CLOSED
        # ====================================================

        try:

            if not print_window.exists():

                log(
                    "Print window closed."
                )

                return "SUCCESS"

        except Exception:

            # Window handle is no longer valid.
            return "SUCCESS"

        # ====================================================
        # WAIT
        # ====================================================

        time.sleep(
            ERROR_CHECK_INTERVAL
        )

    # ========================================================
    # TIMEOUT
    # ========================================================

    log(
        "Print operation timed out."
    )

    return "TIMEOUT"


# ============================================================
# STARTUP
# ============================================================

log("")
log("=" * 70)

log(
    "SAP Auto Print started."
)

log(
    f"Python PID: {os.getpid()}"
)

log(
    f"Script directory: {SCRIPT_DIR}"
)

log(
    f"Log file: {LOG_FILE}"
)

log(
    "Started by Task Scheduler."
)

log(
    "No Python session monitor is being used."
)

log(
    "No single-instance mutex is being used."
)

log(
    "=" * 70
)


# ============================================================
# STARTUP NOTIFICATION
# ============================================================

show_notification(
    "SAP Auto Print",
    "Ready — press F8 to START"
)


# ============================================================
# MAIN AUTOMATION LOOP
# ============================================================

while not shutdown_requested:

    try:

        # ====================================================
        # WAIT WHILE AUTOMATION IS STOPPED
        # ====================================================

        if not automation_running:

            time.sleep(
                CHECK_INTERVAL
            )

            continue

        # ====================================================
        # 1. PDF ERROR HAS HIGHEST PRIORITY
        # ====================================================

        errors = get_pdf_error_windows()

        if errors:

            for dialog, ok_button in errors:

                close_pdf_error(
                    dialog,
                    ok_button
                )

            time.sleep(
                ACTION_DELAY
            )

            continue

        # ====================================================
        # 2. FIND SAP PRINT WINDOWS
        # ====================================================

        print_windows = get_print_windows()

        if not print_windows:

            time.sleep(
                CHECK_INTERVAL
            )

            continue

        # ====================================================
        # 3. PROCESS PRINT WINDOW
        # ====================================================

        for print_window in print_windows:

            try:

                # --------------------------------------------
                # Check F8 state before processing
                # --------------------------------------------

                if not automation_running:

                    break

                handle = print_window.handle

                log(
                    "=" * 60
                )

                log(
                    "PRINT WINDOW DETECTED"
                )

                log(
                    f"Handle: {handle}"
                )

                try:

                    log(
                        "PID: "
                        + str(
                            print_window
                            .element_info
                            .process_id
                        )
                    )

                except Exception:
                    pass

                log(
                    "Title: "
                    + repr(
                        print_window.window_text()
                    )
                )

                # =================================================
                # CLICK PRINT
                # =================================================

                clicked = click_print(
                    print_window
                )

                if not clicked:

                    log(
                        "PRINT button was not clicked."
                    )

                    time.sleep(
                        0.5
                    )

                    continue

                # =================================================
                # WAIT FOR PRINT RESULT
                # =================================================

                result = wait_after_print(
                    print_window
                )

                # =================================================
                # RESULT
                # =================================================

                if result == "SUCCESS":

                    log(
                        "PRINT COMPLETED."
                    )

                elif result == "ERROR":

                    log(
                        "PDF ERROR HANDLED."
                    )

                elif result == "TIMEOUT":

                    log(
                        "PRINT RESULT TIMEOUT."
                    )

                # =================================================
                # READY FOR NEXT PRINT
                # =================================================

                log(
                    "Ready for next SAP print..."
                )

                time.sleep(
                    ACTION_DELAY
                )

                # ------------------------------------------------
                # Process one Print dialog per polling cycle.
                # ------------------------------------------------

                break

            except Exception as e:

                log(
                    "Print window processing error: "
                    + repr(e)
                )

                time.sleep(
                    0.5
                )

                continue

        # ====================================================
        # SMALL POLLING DELAY
        # ====================================================

        time.sleep(
            CHECK_INTERVAL
        )

    # ========================================================
    # UNEXPECTED ERROR
    # ========================================================

    except Exception as e:

        log(
            "Main automation error: "
            + repr(e)
        )

        time.sleep(
            1
        )


# ============================================================
# SHUTDOWN
# ============================================================

try:

    keyboard.unhook_all()

except Exception:
    pass


log(
    "SAP Auto Print stopped."
)


show_notification(
    "SAP Auto Print",
    "Automation CLOSED"
)